from random import random
class Cell:
     def __init__ (self, value = 0):
          self.value = value
          
     def __bool__ (self):
          return self.value == 0


class TicTacToe:
     FREE_CELL = 0    # свободная клетка
     HUMAN_X = 1        # крестик (игрок - человек)
     COMPUTER_O = 2 # нолик (игрок - компьютер)
     
     def __init__ (self, pole = ((Cell(0), Cell(0), Cell(0)), (Cell(0), Cell(0), Cell(0)), (Cell(0), Cell(0), Cell(0))), FREE_CELL = 0, HUMAN_X = 1, COMPUTER_O = 2):
          self.pole = pole

     
     def __getitem__(self, item):
          if type(item[0]) != int or type(item[1]) != int or item[0] < 0 or item[1] < 0 or item[0] > 2 or item[1] > 2:
               raise IndexError('некорректно указанные индексы')
          else:
               return self.pole[item[0]][item[0]].value
     
     def __setitem__(self, item, value):
          if type(item[0]) != int or type(item[1]) != int or item[0] < 0 or item[1] < 0 or item[0] > 2 or item[1] > 2:
               raise IndexError('некорректно указанные индексы')
          else:
               self.pole[item[0]][item[1]].value = value
     
     def init(self):
          for i in range (3):
               for j in range (3):
                    self.pole[i][j].value = 0
               
     def show(self):
          for i in range (3):
               for j in range (3):
                    print(self.pole[i][j].value, end = ' ')
               print()
                    
     def human_go(self, item1, item2, value):
          self.pole[item1][item2].value = value
     
     
     def computer_go(self):
          a = True
          while a:
               b = random.randint(0, 2)
               c = random.randint(0, 2)
               if self.pole[b][c].value == self.FREE_CELL:
                    self.pole[b][c].value = self.COMPUTER_O
                    a = False
                              
     @property
     def is_human_win(self):      # - возвращает True, если победил человек, иначе - False;
          if self.pole[0][0].value == 1:
               if (self.pole[0][1].value == 1 and self.pole[0][2].value == 1) or (self.pole[1][0].value == 1 and self.pole[2][0].value == 1) or (self.pole[1][1].value == 1 and self.pole[2][2].value == 1):
                    return True
          elif self.pole[2][2].value == 1:
               if (self.pole[0][2].value == 1 and self.pole[1][2].value == 1) or (self.pole[2][0].value == 1 and self.pole[2][1].value == 1):
                    return True
          elif self.pole[1][1].value == 1:
               if (self.pole[1][2].value == 1 and self.pole[1][0].value == 1) or (self.pole[2][1].value == 1 and self.pole[0][1].value == 1) or (self.pole[0][2].value == 1 and self.pole[2][0].value == 1):
                    return True
          else:
               return False
     
     @property
     def is_computer_win(self):   # - возвращает True, если победил компьютер, иначе - False;
          if self.pole[0][0].value == 2:
               if (self.pole[0][1].value == 2 and self.pole[0][2].value == 2) or (self.pole[1][0].value == 2 and self.pole[2][0].value == 2) or (self.pole[1][1].value == 2 and self.pole[2][2].value == 2):
                    return True
          elif self.pole[2][2].value == 2:
               if (self.pole[0][2].value == 2 and self.pole[1][2].value == 2) or (self.pole[2][0].value == 2 and self.pole[2][1].value == 2):
                    return True
          elif self.pole[1][1].value == 2:
               if (self.pole[1][2].value == 2 and self.pole[1][0].value == 2) or (self.pole[2][1].value == 2 and self.pole[0][1].value == 2) or (self.pole[0][2].value == 2 and self.pole[2][0].value == 2):
                    return True
          else:
               return False
     
     @property
     def is_draw(self):           # - возвращает True, если ничья, иначе - False.
          if self.pole[0][0].value == self.pole[0][1].value and self.pole[0][1].value == self.pole[0][2].value:
               return False
          elif self.pole[1][0].value == self.pole[1][1].value and self.pole[1][1].value == self.pole[1][2].value:
               return False
          elif self.pole[2][0].value == self.pole[2][1].value and self.pole[2][1].value == self.pole[2][2].value:
               return False
          elif self.pole[0][0].value == self.pole[1][0].value and self.pole[1][0].value == self.pole[2][0].value:
               return False
          elif self.pole[0][1].value == self.pole[1][1].value and self.pole[1][1].value == self.pole[2][1].value:
               return False
          elif self.pole[0][2].value == self.pole[1][2].value and self.pole[1][2].value == self.pole[2][2].value:
               return False
          elif self.pole[0][0].value == self.pole[1][1].value and self.pole[1][1].value == self.pole[2][2].value:
               return False
          elif self.pole[0][2].value == self.pole[1][1].value and self.pole[1][1].value == self.pole[2][0].value:
               return False
          else:
               return True
